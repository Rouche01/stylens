# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Build and distribute a new Android development build via Firebase App Distribution"
  lane :development do |options|
    # Handle input parameters
    version        = options[:version]       || "1.0.0"
    build_number   = options[:build_number]  || 1
    release_notes  = options[:release_notes] || "Lots of amazing new features to test out!"
    groups         = options[:groups]        || "gostylens-vanguards"
    testers        = options[:testers]       || ""
    env            = options[:env]           || "staging"

    # flutter build regenerates GeneratedPluginRegistrant in release mode
    # (dev-only plugins like integration_test are excluded). Prefer this over
    # raw Gradle assembleRelease, which can compile a stale registrant.
    flutter_release_build!(
      artifact: :apk,
      env: env,
      build_name: version.to_s,
      build_number: build_number.to_s,
    )

    # Upload to Firebase App Distribution
    firebase_app_distribution(
      app: "1:727398816020:android:5afeab15183077fb950a01",
      service_credentials_file: "fastlane/service-account.json",
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-release.apk",
      testers: testers.to_s.empty? ? nil : testers,
      groups:  groups.to_s.empty?  ? nil : groups,
      release_notes: release_notes,
      debug: true
    )
  end

  desc "Build and release a new Android production build to Google Play (internal track)"
  lane :production do |options|
    # Handle input parameters
    release_notes  = options[:release_notes] || "Lots of amazing new features to test out!"
    track          = options[:track]         || "internal"
    env            = options[:env]           || "production"
    build_number   = options[:build_number]

    # Resolve the next version code from the Play Store (or use manual override)
    next_version_code = build_number.to_s.strip.empty? ? bump_version_code() : build_number.to_i
    UI.message("🔢 Using version code: #{next_version_code}")

    flutter_release_build!(
      artifact: :appbundle,
      env: env,
      build_number: next_version_code.to_s,
    )

    aab_path = "../build/app/outputs/bundle/release/app-release.aab"
    embedded_code = sh("aapt2 dump badging #{aab_path} 2>/dev/null | grep versionCode | grep -o \"versionCode='[^']*'\" | head -1 || echo 'aapt2 not available'", log: false).strip
    UI.message("✅ AAB embedded version info: #{embedded_code}")

    # Upload to Google Play
    upload_to_play_store(
      track: track,
      aab: aab_path,
      json_key: "fastlane/play-store.json",
      release_status: "draft",
      version_codes_to_retain: [next_version_code],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # ---------------------------------------------------------------------------
  # Helpers
  # ---------------------------------------------------------------------------

  # Builds a release APK or AAB via the Flutter CLI so plugin registration,
  # dart-defines, and R8 setup follow Flutter's release pipeline.
  def flutter_release_build!(artifact:, env:, build_number:, build_name: nil)
    unless %i[apk appbundle].include?(artifact)
      UI.user_error!("Unsupported Flutter artifact: #{artifact}")
    end

    cmd = [
      "flutter", "build", artifact.to_s,
      "--release",
      "--dart-define=ENV=#{env}",
      "--build-number=#{build_number}",
    ]
    cmd << "--build-name=#{build_name}" unless build_name.to_s.strip.empty?

    UI.message("🛠️  #{cmd.join(' ')}")
    Bundler.with_original_env do
      sh("cd .. && #{cmd.join(' ')}")
    end
  end

  # Returns the next versionCode by querying all tracks from Google Play
  # and incrementing the highest found by 1.
  def bump_version_code
    all_codes = []
    %w[internal alpha beta production].each do |t|
      begin
        codes = google_play_track_version_codes(
          track: t,
          json_key: "fastlane/play-store.json"
        )
        all_codes.concat(codes.map(&:to_i))
        UI.message("Track '#{t}' version codes: #{codes}")
      rescue => e
        UI.important("Could not fetch version codes for track '#{t}': #{e.message}")
      end
    end

    if all_codes.empty?
      UI.important("No version codes found across any track. Defaulting to 1.")
      1
    else
      next_code = all_codes.max + 1
      UI.message("Next version code: #{next_code}")
      next_code
    end
  end

  desc "Run integration tests to capture raw screenshots"
  lane :capture_screenshots do
    # Clear old raw screenshots to ensure a fresh run
    sh("rm -rf ./screenshots/en-US/*.png")

    # Run the integration test on the connected simulator/emulator
    Bundler.with_original_env do
      sh("cd .. && flutter drive --dart-define=INTEGRATION_TEST=true --driver=screenshot_driver/integration_test.dart --target=integration_test/screenshot_test.dart")
    end
  end

  desc "Resize and frame raw screenshots locally with custom titles and background colors"
  lane :frame_screenshots do
    # Clear old framed screenshots to ensure a fresh state
    sh("mkdir -p ./framed_screenshots/en-US")
    sh("rm -rf ./framed_screenshots/en-US/*.png")

    # Resize screenshots to standard 1080x1920 (required by frameit) by cropping the bottom off tall devices
    Dir.glob("./screenshots/en-US/*.png").each do |screenshot|
      next if screenshot.include?("_framed")
      # -gravity north ensures we keep the top app bar and only chop off the bottom
      sh("magick #{screenshot} -gravity north -extent 1080x1920 #{screenshot}")
    end

    # Frame the generated screenshots
    frameit(
      path: "./fastlane/screenshots"
    )

    # Move framed screenshots into a separate folder
    sh("mv ./screenshots/en-US/*_framed.png ./framed_screenshots/en-US/")
  end

  desc "Capture, resize, and frame screenshots locally"
  lane :frame_store_screenshots do
    capture_screenshots
    frame_screenshots
  end
end
